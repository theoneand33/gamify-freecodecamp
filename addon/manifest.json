{
  "manifest_version": 3,
  "name": "Gamify freeCodeCamp",
  "version": "0.1.0",
  "description": "Earn XP, levels, streaks and badges for every freeCodeCamp challenge you complete.",
  "icons": { "64": "icon.svg" },
  "permissions": ["storage"],
  "action": { "default_popup": "popup.html", "default_icon": "icon.svg" },
  "content_scripts": [
    {
      "matches": ["https://www.freecodecamp.org/*"],
      "js": ["game.js", "ui.js", "content.js"],
      "css": ["ui.css", "content.css"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "gamify-freecodecamp@example.org",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
